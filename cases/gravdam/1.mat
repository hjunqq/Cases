FOR MC OR DP: FRICT_ANGLE, DILAN_ANGLE                                                                                                                
CAMCLAY    :Pc, lamda, Mg, Mf, D0, D1,gaama                                                                                                           
FOR FLUID: (1) density,ratio,bulkw (2)permiability(1:ndimn)                                                                                           
